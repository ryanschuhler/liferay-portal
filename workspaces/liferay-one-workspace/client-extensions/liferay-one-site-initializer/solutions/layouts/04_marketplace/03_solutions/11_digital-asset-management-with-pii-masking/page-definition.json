											"value": {
												"html": {
													"value_i18n": {
														"en_US": "<div class=\"f-text font-size-paragraph-base\"><style>\n    .carousel-inner {\n        border-radius: 10px;\n        height: 600px !important;\n        overflow: hidden;\n        width: 682.99px;\n    }\n\n    .carousel.slide {\n        height: 600px !important;\n    }\n\n\n    .carousel-image {\n        object-fit: contain;\n        height: 600px;\n    }\n\n    .carousel-indicators {\n        border-radius: 50% !important;\n        bottom: -50px;\n    }\n\n    .carousel-indicators li {\n        border-radius: 50%;\n        height: 10px;\n        width: 10px;\n    }\n\n    .video-preview {\n        border-radius: 10px;\n        overflow: hidden;\n    }\n\n    .video-thumbnail {\n        border-radius: 4px;\n        cursor: pointer;\n        height: 600px;\n        object-fit: cover;\n        transition: all 0.3s ease-in-out;\n        width: 682.99px;\n    }\n\n    .video-thumbnail:hover+.video-thumbnail-play-symbol {\n        opacity: 0.7;\n        transform: scale(110%);\n    }\n\n    .video-thumbnail-play-symbol {\n        color: #fff;\n        font-size: 70px;\n        opacity: 1;\n        position: absolute;\n        transition: all 0.3s ease-in-out;\n    }\n\n    .video-thumbnail-play-symbol:hover {\n        opacity: 0.7;\n        transform: scale(110%);\n    }\n\n    .video-embedded {\n        border: 0;\n        border-radius: 4px;\n        height: 600px;\n        width: 682.99px;\n    }\n</style>\n\n\n\n\n\n\n\n\n\n\n\n\n\n    <div class=\"header-content\">\n        <div class=\"container d-flex\">\n            <div class=\"mr-5\">\n                    <h1 class=\"mb-8\">\n                        Digital Asset Management with PII Masking\n                    </h1>\n\n                    <p>Protect, govern, and manage sensitive enterprise documents through intelligent PII and Aadhaar masking; enhance data security, streamline document classification, and optimize <a href=\"https://www.surekhatech.com/digital-asset-management\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"color: rgb(128, 0, 128);\"><strong><u>digital asset management</u></strong></a>&nbsp;with AI-accelerated Liferay DXP solution.</p><p>Using Liferay DXP’s advanced functionalities, combined with our comprehensive PII <a href=\"https://www.surekhatech.com/data-masking-solutions\" rel=\"noopener noreferrer\" target=\"_blank\" style=\"color: rgb(70, 120, 134);\"><strong><u>Data Masking</u></strong></a><strong>&nbsp;</strong>capabilities, you can kickstart to create a next-generation Digital Asset Management Portal and get it customized to meet your business and team’s specific requirements.</p>\n            </div>\n\n            <div>\n\n\n                    <div id=\"headerCarousel\" class=\"carousel slide\" data-ride=\"carousel\">\n\n                        <ol class=\"carousel-indicators\">\n                                <li data-target=\"#headerCarousel\" data-slide-to=\"0\" class=\"active\">\n                                </li>\n                                <li data-target=\"#headerCarousel\" data-slide-to=\"1\" class=\"\">\n                                </li>\n                                <li data-target=\"#headerCarousel\" data-slide-to=\"2\" class=\"\">\n                                </li>\n                                <li data-target=\"#headerCarousel\" data-slide-to=\"3\" class=\"\">\n                                </li>\n                                <li data-target=\"#headerCarousel\" data-slide-to=\"4\" class=\"\">\n                                </li>\n                        </ol>\n\n                        <div class=\"align-items-center carousel-inner d-flex\">\n\n\n\n\n                                    <div class=\"carousel-item active\">\n                                        <img alt=\"Slide 0\" class=\"d-block w-100 carousel-image\" src=\"[$DOCUMENT_URL:/site-initializer/documents/group/solutions/digital-asset-management-with-pii-masking/002.png$]\">\n                                    </div>\n\n\n\n\n\n\n                                    <div class=\"carousel-item\">\n                                        <img alt=\"Slide 1\" class=\"d-block w-100 carousel-image\" src=\"[$DOCUMENT_URL:/site-initializer/documents/group/solutions/digital-asset-management-with-pii-masking/003.png$]\">\n                                    </div>\n\n\n\n\n\n\n                                    <div class=\"carousel-item\">\n                                        <img alt=\"Slide 2\" class=\"d-block w-100 carousel-image\" src=\"[$DOCUMENT_URL:/site-initializer/documents/group/solutions/digital-asset-management-with-pii-masking/004.png$]\">\n                                    </div>\n\n\n\n\n\n\n                                    <div class=\"carousel-item\">\n                                        <img alt=\"Slide 3\" class=\"d-block w-100 carousel-image\" src=\"[$DOCUMENT_URL:/site-initializer/documents/group/solutions/digital-asset-management-with-pii-masking/005.png$]\">\n                                    </div>\n\n\n\n\n\n\n                                    <div class=\"carousel-item\">\n                                        <img alt=\"Slide 4\" class=\"d-block w-100 carousel-image\" src=\"[$DOCUMENT_URL:/site-initializer/documents/group/solutions/digital-asset-management-with-pii-masking/006.png$]\">\n                                    </div>\n\n\n                        </div>\n\n                        <a class=\"carousel-control-prev\" href=\"#headerCarousel\" role=\"button\" data-slide=\"prev\">\n                            <span class=\"carousel-control-prev-icon\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only\">Previous</span>\n                        </a>\n\n                        <a class=\"carousel-control-next\" href=\"#headerCarousel\" role=\"button\" data-slide=\"next\">\n                            <span class=\"carousel-control-next-icon\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only\">Next</span>\n                        </a>\n                    </div>\n            </div>\n        </div>\n    </div></div>"
