												"html": {
													"value_i18n": {
														"en_US": "<div class=\"f-text font-size-paragraph-base\"><style>\n    .carousel-inner {\n        border-radius: 10px;\n        height: 600px !important;\n        overflow: hidden;\n        width: 682.99px;\n    }\n\n    .carousel.slide {\n        height: 600px !important;\n    }\n\n\n    .carousel-image {\n        object-fit: contain;\n        height: 600px;\n    }\n\n    .carousel-indicators {\n        border-radius: 50% !important;\n        bottom: -50px;\n    }\n\n    .carousel-indicators li {\n        border-radius: 50%;\n        height: 10px;\n        width: 10px;\n    }\n\n    .video-preview {\n        border-radius: 10px;\n        overflow: hidden;\n    }\n\n    .video-thumbnail {\n        border-radius: 4px;\n        cursor: pointer;\n        height: 600px;\n        object-fit: cover;\n        transition: all 0.3s ease-in-out;\n        width: 682.99px;\n    }\n\n    .video-thumbnail:hover+.video-thumbnail-play-symbol {\n        opacity: 0.7;\n        transform: scale(110%);\n    }\n\n    .video-thumbnail-play-symbol {\n        color: #fff;\n        font-size: 70px;\n        opacity: 1;\n        position: absolute;\n        transition: all 0.3s ease-in-out;\n    }\n\n    .video-thumbnail-play-symbol:hover {\n        opacity: 0.7;\n        transform: scale(110%);\n    }\n\n    .video-embedded {\n        border: 0;\n        border-radius: 4px;\n        height: 600px;\n        width: 682.99px;\n    }\n</style>\n\n\n\n\n\n\n\n\n\n\n\n\n\n    <div class=\"header-content\">\n        <div class=\"container d-flex\">\n            <div class=\"mr-5\">\n                    <h1 class=\"mb-8\">\n                        Empowering Insurers with Modern Digital Capabilities\n                    </h1>\n\n                    <p>InsureGuard is purpose-built to modernize traditional insurance operations with a</p><p>future-ready approach. Our platform combines low-code agility with powerful AI and</p><p>intelligent process automation, enabling insurers to rapidly launch and iterate on</p><p>customer-facing digital solutions. Whether you're creating a digital policy issuance</p><p>portal, streamlining claims processing, or enhancing policyholder self-service</p><p>experiences, InsureGuard delivers the tools needed to compete in today’s digital-first landscape.</p><p><br></p><p>With prebuilt components and seamless integrations, insurers can shorten time-to-</p><p>market, reduce operational costs, and deliver hyper-personalized customer journeys</p><p>across channels.</p>\n            </div>\n\n            <div>\n\n\n                    <div id=\"headerCarousel\" class=\"carousel slide\" data-ride=\"carousel\">\n\n                        <ol class=\"carousel-indicators\">\n                                <li data-target=\"#headerCarousel\" data-slide-to=\"0\" class=\"active\">\n                                </li>\n                                <li data-target=\"#headerCarousel\" data-slide-to=\"1\" class=\"\">\n                                </li>\n                                <li data-target=\"#headerCarousel\" data-slide-to=\"2\" class=\"\">\n                                </li>\n                                <li data-target=\"#headerCarousel\" data-slide-to=\"3\" class=\"\">\n                                </li>\n                                <li data-target=\"#headerCarousel\" data-slide-to=\"4\" class=\"\">\n                                </li>\n                                <li data-target=\"#headerCarousel\" data-slide-to=\"5\" class=\"\">\n                                </li>\n                                <li data-target=\"#headerCarousel\" data-slide-to=\"6\" class=\"\">\n                                </li>\n                                <li data-target=\"#headerCarousel\" data-slide-to=\"7\" class=\"\">\n                                </li>\n                                <li data-target=\"#headerCarousel\" data-slide-to=\"8\" class=\"\">\n                                </li>\n            