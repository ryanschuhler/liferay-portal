image\" src=\"[$DOCUMENT_URL:/site-initializer/documents/group/solutions/insureguard/003.png$]\">\n                                    </div>\n\n\n\n\n\n\n                                    <div class=\"carousel-item\">\n                                        <img alt=\"Slide 2\" class=\"d-block w-100 carousel-image\" src=\"[$DOCUMENT_URL:/site-initializer/documents/group/solutions/insureguard/004.png$]\">\n                                    </div>\n\n\n\n\n\n\n                                    <div class=\"carousel-item\">\n                                        <img alt=\"Slide 3\" class=\"d-block w-100 carousel-image\" src=\"[$DOCUMENT_URL:/site-initializer/documents/group/solutions/insureguard/005.png$]\">\n                                    </div>\n\n\n\n\n\n\n                                    <div class=\"carousel-item\">\n                                        <img alt=\"Slide 4\" class=\"d-block w-100 carousel-image\" src=\"[$DOCUMENT_URL:/site-initializer/documents/group/solutions/insureguard/006.png$]\">\n                                    </div>\n\n\n\n\n\n\n                                    <div class=\"carousel-item\">\n                                        <img alt=\"Slide 5\" class=\"d-block w-100 carousel-image\" src=\"[$DOCUMENT_URL:/site-initializer/documents/group/solutions/insureguard/007.png$]\">\n                                    </div>\n\n\n\n\n\n\n                                    <div class=\"carousel-item\">\n                                        <img alt=\"Slide 6\" class=\"d-block w-100 carousel-image\" src=\"[$DOCUMENT_URL:/site-initializer/documents/group/solutions/insureguard/008.png$]\">\n                                    </div>\n\n\n\n\n\n\n                                    <div class=\"carousel-item\">\n                                        <img alt=\"Slide 7\" class=\"d-block w-100 carousel-image\" src=\"[$DOCUMENT_URL:/site-initializer/documents/group/solutions/insureguard/009.png$]\">\n                 