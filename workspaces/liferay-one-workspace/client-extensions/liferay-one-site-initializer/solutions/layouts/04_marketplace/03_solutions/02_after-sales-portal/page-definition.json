											"value": {
												"html": {
													"value_i18n": {
														"en_US": "<div class=\"f-text font-size-paragraph-base\"><style>\n\t.catalog-icon {\n\t\twidth: 90px;\n\t}\n\n\t.company-description-container {\n\t\twidth: 846px;\n\t}\n\n\t.company-description-icons-container {\n\t\tborder-radius: 10px;\n\t\tborder: solid 1.5px #E2E2E4;\n\t\twidth: 846px;\n\t}\n\n\t.company-icon {\n\t\theight: 48px;\n\t\twidth: 48px;\n\t}\n</style>\n\n\n\n\n\n\n\n\n\n\t<div class=\"block-container\">\n\t\t<div class=\"align-items-center container d-flex flex-column\">\n\n\t\t\t<h1 class=\"mb-6\">\n\t\t\t\tPRODYNA\n\t\t\t</h1>\n\n\t\t\t<div class=\"company-description-container mb-6\">\n\t\t\t\t<p><span style=\"color: rgb(0, 0, 0);\">PRODYNA is a European IT consulting and digitalization company delivering tailored, agile digital solutions—apps, platforms, and more. Interdisciplinary teams combine user needs, business value, and technology into scalable results. Their approach, based on Experience‑Driven Development, leverages cloud and AI across the full lifecycle—from concept to operation.</span></p>\n\t\t\t</div>\n\n\t\t\t<div class=\"bg-white company-description-icons-container d-flex justify-content-between px-8 py-7\">\n\t\t\t\t\t<div class=\"d-flex flex-row\">\n\t\t\t\t\t\t<div class=\"align-items-center d-flex mr-2\">\n\t\t\t\t\t\t\t<img class=\"company-icon\" aria-label=\"video-thumbnail\" src=\"[$DOCUMENT_URL:/site-initializer/documents/group/solutions/after-sales-portal/007.png$]\">\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"d-flex flex-column\">\n\t\t\t\t\t\t<h2 class=\"m-0\">Website</h2>\n\t\t\t\t\t\t\t<a class=\"font-weight-bold\" href=\"https://www.prodyna.com\" target=\"_blank\">\n\t\t\t\t\t\t\t\twww.prodyna.com\n\t\t\t\t\t\t\t</a>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\n\t\t\t\t\t<div class=\"d-flex flex-row\">\n\t\t\t\t\t\t<div class=\"align-items-center d-flex mr-2\">\n\t\t\t\t\t\t\t<img class=\"company-icon\" aria-label=\"video-thumbnail\" src=\"[$DOCUMENT_URL:/site-initializer/documents/group/s