											"value": {
												"html": {
													"value_i18n": {
														"en_US": "<div class=\"f-text font-size-paragraph-base\"><style>\n    .carousel-inner {\n        border-radius: 10px;\n        height: 600px !important;\n        overflow: hidden;\n        width: 682.99px;\n    }\n\n    .carousel.slide {\n        height: 600px !important;\n    }\n\n\n    .carousel-image {\n        object-fit: contain;\n        height: 600px;\n    }\n\n    .carousel-indicators {\n        border-radius: 50% !important;\n        bottom: -50px;\n    }\n\n    .carousel-indicators li {\n        border-radius: 50%;\n        height: 10px;\n        width: 10px;\n    }\n\n    .video-preview {\n        border-radius: 10px;\n        overflow: hidden;\n    }\n\n    .video-thumbnail {\n        border-radius: 4px;\n        cursor: pointer;\n        height: 600px;\n        object-fit: cover;\n        transition: all 0.3s ease-in-out;\n        width: 682.99px;\n    }\n\n    .video-thumbnail:hover+.video-thumbnail-play-symbol {\n        opacity: 0.7;\n        transform: scale(110%);\n    }\n\n    .video-thumbnail-play-symbol {\n        color: #fff;\n        font-size: 70px;\n        opacity: 1;\n        position: absolute;\n        transition: all 0.3s ease-in-out;\n    }\n\n    .video-thumbnail-play-symbol:hover {\n        opacity: 0.7;\n        transform: scale(110%);\n    }\n\n    .video-embedded {\n        border: 0;\n        border-radius: 4px;\n        height: 600px;\n        width: 682.99px;\n    }\n</style>\n\n\n\n\n\n\n\n\n\n\n\n\n\n    <div class=\"header-content\">\n        <div class=\"container d-flex\">\n            <div class=\"mr-5\">\n                    <h1 class=\"mb-8\">\n                        Streamlined Rebate Operations to Prevent Revenue Loss and Drive Enterprise Growth\n                    </h1>\n\n                    <p>Rebate Ninja is a centralized rebate management solution that eliminates revenue leakage, automates complex rebate workflows, and strengthens partner collaboration. It unifies agreements, claims, accruals, and settlements in one platform while integrating seamlessly with ERP and CRM systems. With AI-driven analytics, real-time dashboards, workflow automation, and audit-ready compliance, Rebate Ninja enables enterprises to scale operations, reduce manual effort, and improve financial performance. The platform also enhances accuracy, boosts partner trust, and provides complete visibility across teams and regions.</p>\n            </div>\n\n            <div>\n\n\n                    <div id=\"headerCarousel\" class=\"carousel slide\" data-ride=\"carousel\">\n\n                        <ol class=\"carousel-indicators\">\n                                <li data-target=\"#headerCarousel\" data-slide-to=\"0\" class=\"active\">\n                                </li>\n                                <li data-target=\"#headerCarousel\" data-slide-to=\"1\" class=\"\">\n                                </li>\n                                <li data-target=\"#headerCarousel\" data-slide-to=\"2\" class=\"\">\n                                </li>\n                                <li data-target=\"#headerCarousel\" data-slide-to=\"3\" class=\"\">\n                                </li>\n                        </ol>\n\n                        <div class=\"align-items-center carousel-inner d-flex\">\n\n\n\n\n                                    <div class=\"carousel-item active\">\n                                        <img alt=\"Slide 0\" class=\"d-block w-100 carousel-image\" src=\"[$DOCUMENT_URL:/site-initializer/documents/group/solutions/rebate-ninja-intelligent-rebate-management/002.png$]\">\n                                    </div>\n\n\n\n\n\n\n                                    <div class=\"carousel-item\">\n                                        <img alt=\"Slide 1\" class=\"d-block w-100 carousel-image\" src=\"[$DOCUMENT_URL:/site-initializer/documents/group/solutions/rebate-ninja-intelligent-rebate-management/003.png$]\">\n                                    </div>\n\n\n\n\n\n\n                                    <div class=\"carousel-item\">\n                                        <img alt=\"Slide 2\" class=\"d-block w-100 carousel-image\" src=\"[$DOCUMENT_URL:/site-initializer/documents/group/solutions/rebate-ninja-intelligent-rebate-management/004.png$]\">\n                                    </div>\n\n\n\n\n\n\n                                    <div class=\"carousel-item\">\n                                        <img alt=\"Slide 3\" class=\"d-block w-100 carousel-image\" src=\"[$DOCUMENT_URL:/site-initializer/documents/group/solutions/rebate-ninja-intelligent-rebate-management/005.png$]\">\n                                    </div>\n\n\n                        </div>\n\n                        <a class=\"carousel-control-prev\" href=\"#headerCarousel\" role=\"button\" data-slide=\"prev\">\n                            <span class=\"carousel-control-prev-icon\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only\">Previous</span>\n                        </a>\n\n                        <a class=\"carousel-control-next\" href=\"#headerCarousel\" role=\"button\" data-slide=\"next\">\n                            <span class=\"carousel-control-next-icon\" aria-hidden=\"true\"></span>\n                            <span class=\"sr-only\">Next</span>\n                        </a>\n                    </div>\n            </div>\n        </div>\n    </div></div>"
													}
												}
											}
										}
									],
									"indexed": true
